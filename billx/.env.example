# Copy of the key names the build uses (section 3.1). Real values go in ~/billx/.env,
# which git ignores. Never put a value in this file.
BILLX_OPENAI_API_KEY=
BILLX_ANTHROPIC_API_KEY=
OPENAI_BUILD_REVIEW_KEY=
LLAMA_CLOUD_API_KEY=
# LlamaIndex API region for the llamaparse reader (default https://api.cloud.llamaindex.ai)
BILLX_LLAMA_BASE_URL=
# The docling reader: the docling-serve URL (empty: the reader is off) and its timeout in seconds
BILLX_DOCLING_URL=
BILLX_DOCLING_TIMEOUT=
ESGOS_REGISTRY_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
ANTHROPIC_CONSOLE_KEY=
# Model ids (O2); doctor.sh calls each once
BILLX_MODEL_A=openai:gpt-6.1-sol
BILLX_MODEL_B=anthropic:claude-sonnet-5-5
BILLX_MODEL_REVIEW=openai:gpt-6-astra
BILLX_MODEL_ASSISTANT=openai:gpt-6.1-sol
# The external drive for the nightly mirror, e.g. /Volumes/BillxMirror
BILLX_MIRROR_VOLUME=
