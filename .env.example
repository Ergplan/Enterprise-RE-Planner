# Copy to .env on the build machine and fill in. Never commit .env.

# Postgres
POSTGRES_USER=ergplan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ergplan
DATABASE_URL=postgresql+psycopg://ergplan:change-me@postgres:5432/ergplan

# API
ERGPLAN_ENV=dev
ERGPLAN_SECRET=change-me-long-random
ERGPLAN_DATA_DIR=/data
ERGPLAN_PUBLIC_URL=http://localhost:3000
ERGPLAN_RESETTLE_TOLERANCE_KWH=1

# billx sidecar (bill reading, contract esgos-1.1)
BILLX_URL=http://billx:8080
BILLX_TOKEN=change-me-long-random
BILLX_OPENAI_API_KEY=
BILLX_ANTHROPIC_API_KEY=

# Models: OpenAI only (only apps/api/ergplan/providers reads these). No Anthropic API key: Claude builds on the subscription.
OPENAI_API_KEY=
OPENAI_MODEL_REGREADER=gpt-5.1
OPENAI_MODEL_EXPLAIN=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime

# tariff-oder (upstream tariff-order extraction pipeline, Ergplan/tariff-oder)
TARIFF_ODER_URL=
TARIFF_ODER_TOKEN=

# Independent reviewer (tools/review/run.sh) — a different family from the builder
REVIEWER_PROVIDER=openai
REVIEWER_MODEL=gpt-5.1

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
