<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly evaluation (section 12.2). Written in Stage 0, INACTIVE until Stage 11:
     install-jobs.sh does not load it. It mirrors, runs billx eval on the golden set and
     opens a pull request adding docs/accuracy/<date>.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.joulewise.billx.eval</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string><string>"$HOME/billx/tools/mac/nightly-eval.sh"</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardErrorPath</key><string>/tmp/billx-eval.err</string>
</dict>
</plist>
