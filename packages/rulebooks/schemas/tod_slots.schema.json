{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tod_slots.schema.json",
  "title": "ToD slots",
  "description": "A DISCOM's time-of-day slot definitions for a category and season, with the surcharge or rebate per slot.",
  "type": "object",
  "required": [
    "scope",
    "body",
    "source_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "scope": {
      "$ref": "scope.schema.json"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slots"
      ],
      "properties": {
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "start",
              "end"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "peak, off_peak, normal, morning_peak … as the order names them"
              },
              "start": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "description": "HH:MM, 24-hour"
              },
              "end": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "description": "HH:MM, 24-hour"
              },
              "months": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "uniqueItems": true,
                "description": "Calendar months the item applies to; omit for all"
              },
              "surcharge_pct": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "description": "ToD surcharge on the energy charge (percent, decimal as string)"
              },
              "rebate_pct": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "description": "ToD rebate on the energy charge (percent, decimal as string)"
              },
              "rate_delta_inr_per_kwh": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "description": "Absolute ToD adjustment where the order states INR/kWh (decimal as string)"
              }
            }
          }
        },
        "season_note": {
          "type": "string"
        }
      }
    },
    "source_ref": {
      "$ref": "source_ref.schema.json"
    },
    "position": {
      "type": "integer",
      "minimum": 0
    },
    "field_refs": {
      "type": "object",
      "description": "Citation per body field (JSON pointer such as /energy_charge/base) when it differs from the row's source_ref",
      "additionalProperties": {
        "$ref": "source_ref.schema.json"
      }
    },
    "label": {
      "type": "string",
      "description": "Short human label, e.g. 'HV-2 · supply at 11 kV'"
    }
  }
}