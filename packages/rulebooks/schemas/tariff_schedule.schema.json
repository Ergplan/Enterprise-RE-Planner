{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tariff_schedule.schema.json",
  "title": "Tariff schedule",
  "description": "Retail rates for one DISCOM category and voltage from the tariff order. One row per category/voltage; slot names refer to the tod_slots family.",
  "type": "object",
  "required": [
    "scope",
    "body",
    "source_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "scope": {
      "$ref": "scope.schema.json"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "billing_basis",
        "demand_charge",
        "energy_charge"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "billing_basis": {
          "enum": [
            "kwh",
            "kvah"
          ]
        },
        "demand_charge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "description": "Fixed/demand charge (decimal as string). With slabs: the rate of the last (highest) slab"
            },
            "basis": {
              "enum": [
                "inr_per_kva_month",
                "inr_per_kw_month",
                "inr_per_kva_month_billing_demand"
              ]
            },
            "billing_demand_rule": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min_pct_of_contract_demand": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$",
                  "description": "Billing demand floor as % of contract demand (e.g. 75) (percent, decimal as string)"
                },
                "excess_demand_penalty_multiplier": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?$",
                  "description": "Multiple of demand charge on demand above contract (e.g. 2)"
                },
                "min_kva": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$",
                  "description": "Billing demand is never below this many kVA (GERC: one hundred kVA)"
                },
                "excess_demand_rate": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$",
                  "description": "INR/kVA/month on billing demand above contract demand, charged instead of the slab rates for that part (GERC HTP-I 11.1.2)"
                }
              }
            },
            "slabs": {
              "type": "array",
              "minItems": 1,
              "description": "Telescopic slabs of billing demand (GERC HTP-I: first 500 kVA, next 500 kVA, above 1000 kVA); each slab's rate applies to the kVA inside it. The last slab has no up_to_kva.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "up_to_kva": {
                    "type": "string",
                    "pattern": "^-?\\d+(\\.\\d+)?$",
                    "description": "Upper edge of the slab in kVA of billing demand (cumulative); omit on the last slab"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^-?\\d+(\\.\\d+)?$",
                    "description": "INR/kVA/month for the kVA inside this slab"
                  }
                }
              }
            }
          }
        },
        "energy_charge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base"
          ],
          "properties": {
            "base": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "description": "Energy charge per billed unit (basis above) (decimal as string)"
            },
            "by_slot": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "description": "Energy charge for this slot where the order prices slots directly (decimal as string)"
              }
            },
            "by_billing_demand": {
              "type": "array",
              "description": "Energy charge for the entire consumption chosen by the month's billing demand (GERC HTP-I 11.2): the last band whose above_kva is below the billing demand applies; base applies below the first band.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "above_kva",
                  "base"
                ],
                "properties": {
                  "above_kva": {
                    "type": "string",
                    "pattern": "^-?\\d+(\\.\\d+)?$",
                    "description": "Billing demand above which this band applies"
                  },
                  "base": {
                    "type": "string",
                    "pattern": "^-?\\d+(\\.\\d+)?$",
                    "description": "Energy charge per billed unit in this band"
                  }
                }
              }
            },
            "rebate_pct": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "description": "Rebate on the energy charges, e.g. for supply at a higher voltage (GERC 11.9) (percent, decimal as string)"
            }
          }
        },
        "fppca_inr_per_unit": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "description": "Fuel/power purchase cost adjustment per billed unit, as currently notified (decimal as string)"
        },
        "electricity_duty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pct": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "description": "ED as % of energy charge (percent, decimal as string)"
            },
            "inr_per_unit": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "description": "ED per unit (decimal as string)"
            }
          }
        },
        "pf_incentive": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pf_min",
              "pf_max",
              "pct"
            ],
            "properties": {
              "pf_min": {
                "type": "number"
              },
              "pf_max": {
                "type": "number"
              },
              "pct": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "description": "+ incentive / − penalty on energy charge (percent, decimal as string)"
              }
            }
          }
        },
        "lf_incentive": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lf_min_pct",
              "lf_max_pct",
              "rebate_inr_per_unit"
            ],
            "properties": {
              "lf_min_pct": {
                "type": "number"
              },
              "lf_max_pct": {
                "type": "number"
              },
              "rebate_inr_per_unit": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$",
                "description": "Rebate on units above the LF threshold (decimal as string)"
              }
            }
          }
        },
        "prompt_payment_rebate_pct": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "description": "Rebate for payment within the stated days (percent, decimal as string)"
        },
        "minimum_charge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inr_per_kva_month": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "description": "Minimum charge basis (decimal as string)"
            },
            "min_units_per_kva_month": {
              "type": "number"
            }
          }
        },
        "green_tariff_premium_inr_per_unit": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "description": "Premium for DISCOM green tariff where offered (decimal as string)"
        },
        "taxes_pct": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "description": "Other taxes/cess on the bill (percent, decimal as string)"
        },
        "notes": {
          "type": "string"
        },
        "retail_wheeling_charge": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "description": "Wheeling charge billed per unit with the energy charge to every consumer of the category (MERC HT and LT schedules), per billed unit (decimal as string)"
        }
      }
    },
    "source_ref": {
      "$ref": "source_ref.schema.json"
    },
    "position": {
      "type": "integer",
      "minimum": 0
    },
    "field_refs": {
      "type": "object",
      "description": "Citation per body field (JSON pointer such as /energy_charge/base) when it differs from the row's source_ref",
      "additionalProperties": {
        "$ref": "source_ref.schema.json"
      }
    },
    "label": {
      "type": "string",
      "description": "Short human label, e.g. 'HV-2 · supply at 11 kV'"
    }
  }
}
