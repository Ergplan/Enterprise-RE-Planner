{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_ref.schema.json",
  "title": "SourceRef",
  "description": "Where a value comes from. A regulation/order ref must resolve to a stored PDF page: /documents/{document_id}#page={page}.",
  "type": "object",
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "regulation",
        "order",
        "client_stated",
        "assumption",
        "measured",
        "derived",
        "bill",
        "market"
      ]
    },
    "document_id": {
      "type": "string",
      "description": "source_documents.id"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based printed page the quote is on"
    },
    "quote": {
      "type": "string",
      "maxLength": 400,
      "description": "Verbatim text from that page"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "printed_page": {
      "type": "string",
      "description": "The page number printed on the page, when it differs from the PDF index"
    },
    "bill_id": {
      "type": "string",
      "description": "bills.id, for a value billx read from the client's bill"
    },
    "field_path": {
      "type": "string",
      "description": "the billx contract path of that value (e.g. demand.max_kva)"
    },
    "vintage_id": {
      "type": "string",
      "description": "price_vintages.id, for a market price (kind market)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "regulation",
              "order"
            ]
          }
        }
      },
      "then": {
        "required": [
          "document_id",
          "page",
          "quote"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bill"
          }
        }
      },
      "then": {
        "required": [
          "bill_id",
          "field_path"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "market"
          }
        }
      },
      "then": {
        "required": [
          "vintage_id"
        ]
      }
    }
  ]
}
