{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_ref.schema.json",
  "title": "SourceRef",
  "description": "Where a value comes from. A regulation/order ref must resolve to a stored PDF page: /documents/{document_id}#page={page}.",
  "type": "object",
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "regulation",
        "order",
        "client_stated",
        "assumption",
        "measured",
        "derived"
      ]
    },
    "document_id": {
      "type": "string",
      "description": "source_documents.id"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based printed page the quote is on"
    },
    "quote": {
      "type": "string",
      "maxLength": 300,
      "description": "Verbatim text from that page"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 500
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "regulation",
              "order"
            ]
          }
        }
      },
      "then": {
        "required": [
          "document_id",
          "page",
          "quote"
        ]
      }
    }
  ]
}