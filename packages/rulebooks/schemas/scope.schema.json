{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scope.schema.json",
  "title": "Scope",
  "description": "When a rule row applies. Every listed field must match the evaluation context; an omitted field matches anything.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "connection": {
      "type": "array",
      "items": {
        "enum": [
          "ists",
          "intra_state",
          "behind_meter"
        ]
      },
      "uniqueItems": true
    },
    "source": {
      "type": "array",
      "items": {
        "enum": [
          "solar",
          "wind",
          "hybrid",
          "biomass",
          "small_hydro",
          "waste_to_energy",
          "bess",
          "pumped_storage",
          "thermal",
          "iex",
          "any_re",
          "any"
        ]
      },
      "uniqueItems": true
    },
    "ownership": {
      "type": "array",
      "items": {
        "enum": [
          "captive",
          "group_captive",
          "third_party",
          "discom"
        ]
      },
      "uniqueItems": true
    },
    "consumer_kind": {
      "type": "array",
      "items": {
        "enum": [
          "ht",
          "eht",
          "lt"
        ]
      },
      "uniqueItems": true
    },
    "voltage_kv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "min_exclusive": {
          "type": "boolean",
          "description": "true: strictly above min (\"above 11 kV\")"
        },
        "max_exclusive": {
          "type": "boolean",
          "description": "true: strictly below max"
        }
      },
      "description": "Inclusive band of the consumer's supply voltage"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DISCOM tariff category codes as printed (e.g. HV-2, HT-I)"
    },
    "capacity_mw": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "min_exclusive": {
          "type": "boolean",
          "description": "true: strictly above min (\"above 11 kV\")"
        },
        "max_exclusive": {
          "type": "boolean",
          "description": "true: strictly below max"
        }
      }
    },
    "contract_demand_kva": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "min_exclusive": {
          "type": "boolean",
          "description": "true: strictly above min (\"above 11 kV\")"
        },
        "max_exclusive": {
          "type": "boolean",
          "description": "true: strictly below max"
        }
      }
    },
    "commissioned": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "Generator commissioning date band"
    },
    "iex_segment": {
      "type": "array",
      "items": {
        "enum": [
          "dam",
          "rtm",
          "gdam",
          "gtam",
          "tam",
          "hpdam"
        ]
      },
      "uniqueItems": true
    },
    "months": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "uniqueItems": true,
      "description": "Calendar months the item applies to; omit for all"
    },
    "load_kw": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "min_exclusive": {
          "type": "boolean",
          "description": "true: strictly above min (\"above 11 kV\")"
        },
        "max_exclusive": {
          "type": "boolean",
          "description": "true: strictly below max"
        }
      },
      "description": "Contracted or sanctioned load band in kW (or kVA where the order says so)"
    },
    "season": {
      "type": "string",
      "description": "Season name as the order prints it (summer, winter, monsoon)"
    },
    "rate_block": {
      "type": "string",
      "description": "The order's lettered sub-category text, when one category has several rate blocks"
    }
  }
}